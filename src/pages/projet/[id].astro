---
import projets from "../../data/projets.json";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  return projets.map((projet) => {
    return { params: { id: projet.id } };
  });
}

const { id } = Astro.params; // id utilisé entre autre pour le routage du "slug" de la page dynamique
const projet = projets.find((p) => p.id === id); // chercher le contenu du json pour le projet en fonction de l'id
---

<Layout title={projet.title}>
  <h1>{id}</h1>
  <p>{projet.title}</p>
</Layout>
