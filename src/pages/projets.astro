---
import Layout from "../layouts/Layout.astro";
import projets from "../data/projets.json";
---

<Layout title="Matteo Sacco | Projets">
  <section class="py-8">
    <div class="mb-12 opacity-0 animate-fade-in">
      <p class="text-sm font-medium tracking-widest uppercase text-accent-400 mb-4">
        Portfolio
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-zinc-100">
        Mes projets
      </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projets.map((projet, index) => (
          <a
            href={`${import.meta.env.BASE_URL}/projet/${projet.id}`}
            class:list={[
              "group relative overflow-hidden rounded-2xl border border-zinc-800/50 bg-zinc-900/30 backdrop-blur-sm transition-all duration-300 hover:border-accent-400/30 hover:bg-zinc-800/20 hover:scale-[1.02] opacity-0",
              index === 0 && "animate-fade-in-delay-1",
              index === 1 && "animate-fade-in-delay-2",
              index === 2 && "animate-fade-in-delay-3",
              index >= 3 && "animate-fade-in-delay-3",
            ]}
          >
            <div class="flex items-center gap-4 p-4 border-b border-zinc-800/30">
              <img
                class="w-10 h-10 object-contain opacity-70 group-hover:opacity-100 transition-opacity invert"
                src={projet.Images.Image1}
                alt=""
              />
              {projet.Images.Image2 && (
                <img
                  class="w-10 h-10 object-contain opacity-70 group-hover:opacity-100 transition-opacity invert"
                  src={projet.Images.Image2}
                  alt=""
                />
              )}
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-zinc-100 mb-1 group-hover:text-accent-400 transition-colors">
                {projet.title}
              </h3>
              <p class="text-sm text-zinc-500">
                {projet.Outils.Outil1}
                {projet.Outils.Outil2 ? ` / ${projet.Outils.Outil2}` : ""}
                {projet.Outils.Outil3 ? ` / ${projet.Outils.Outil3}` : ""}
              </p>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-accent-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" />
          </a>
        ))
      }
    </div>
  </section>
</Layout>
