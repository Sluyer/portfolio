---
import Layout from "../layouts/Layout.astro";
import projets from "../data/projets.json";
---

<Layout title="SACCO Matteo | Projets">
  <h1>Mes projets</h1>
  <ul>
    <!-- Création du routage dynamique pour chaque projet -->
    {
      projets.map((projet) => {
        return (
          <li>
            <a href={`/projet/${projet.id}`}>{projet.title}</a>
          </li>
        );
      })
    }
  </ul>
</Layout>

<style></style>
