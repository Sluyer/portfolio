---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SACCO Matteo | CV">
  <div class="flex flex-wrap">
    <header class="flex flex-wrap p-2 w-full">
      <div>
        <p class="font-sans font-bold text-2xl w-max">SACCO Matteo</p>
        <p class="font-sans font-bold text-2xl w-max">
          20 ans Etudiant Licence
        </p>
      </div>
      <div class="flex flex-wrap ml-auto gap-6 pr-6">
        <img src="images/tailwind-css-black.png" alt="" width={512 / 8} />
        <img src="images/node-black.png" alt="" width={512 / 8} />
        <img src="images/next-black.png" alt="" width={512 / 8} />
        <img src="images/react-black.png" alt="" width={512 / 8} />
      </div>
      <div class="border-b-2 w-[95%] mx-auto mt-2 drop-shadow-lg"></div>
    </header>
    <body class="flex flex-wrap">
      <!-- formations et diplomes + experiences professionnelles -->
      <div class="bg-red-200 p-2 w-[65%]">
        <p class="font-sans font-bold text-lg drop-shadow-lg">
          Formations Et Diplômes
        </p>
        <p>2018 | Key English Test | Pass with Merit</p>
      </div>
      <!-- autres -->
      <div class="bg-red-200 p-2 ml-auto w-[30%]"></div>
      <!-- contact -->
      <div class="bg-blue-200 p-2 w-full"></div>
    </body>
  </div>
</Layout>

