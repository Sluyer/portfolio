---
import Tag from "../../components/Tag.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Matteo Sacco | Contact">
  <section class="py-8">
    <div class="mb-10 opacity-0 animate-fade-in">
      <p class="text-sm font-medium tracking-widest uppercase text-accent-400 mb-4">
        Contact
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-zinc-100 mb-3">
        Intéressé(e) ?
      </h1>
      <p class="text-xl text-zinc-400 font-light">
        Rentrons en contact...
      </p>
    </div>

    <div class="mb-8 opacity-0 animate-fade-in-delay-1">
      <Tag href="https://www.linkedin.com/in/matteo-sacco-259571251">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </Tag>
    </div>

    <form class="max-w-2xl opacity-0 animate-fade-in-delay-2" action={`${import.meta.env.BASE_URL}/contact/success`} method="GET">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div class="flex flex-col gap-1.5">
          <label for="Nom" class="text-sm font-medium text-zinc-400">Nom</label>
          <input
            class="px-4 py-3 rounded-xl bg-zinc-900/50 border border-zinc-800/50 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-accent-400/50 focus:ring-1 focus:ring-accent-400/20 transition-all"
            type="text"
            name="Nom"
            id="Nom"
            placeholder="Votre Nom"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="Prenom" class="text-sm font-medium text-zinc-400">Prénom</label>
          <input
            class="px-4 py-3 rounded-xl bg-zinc-900/50 border border-zinc-800/50 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-accent-400/50 focus:ring-1 focus:ring-accent-400/20 transition-all"
            type="text"
            name="Prenom"
            id="Prenom"
            placeholder="Votre Prénom"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1.5 mb-4">
        <label for="email" class="text-sm font-medium text-zinc-400">E-mail</label>
        <input
          class="px-4 py-3 rounded-xl bg-zinc-900/50 border border-zinc-800/50 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-accent-400/50 focus:ring-1 focus:ring-accent-400/20 transition-all"
          type="email"
          name="email"
          id="email"
          placeholder="Votre email"
        />
      </div>

      <div class="flex flex-col gap-1.5 mb-4">
        <label for="Objet" class="text-sm font-medium text-zinc-400">Objet</label>
        <input
          class="px-4 py-3 rounded-xl bg-zinc-900/50 border border-zinc-800/50 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-accent-400/50 focus:ring-1 focus:ring-accent-400/20 transition-all"
          type="text"
          name="Objet"
          id="Objet"
          placeholder="Objet du message"
        />
      </div>

      <div class="flex flex-col gap-1.5 mb-6">
        <label for="Contenu" class="text-sm font-medium text-zinc-400">Message</label>
        <textarea
          class="px-4 py-3 rounded-xl bg-zinc-900/50 border border-zinc-800/50 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-accent-400/50 focus:ring-1 focus:ring-accent-400/20 transition-all resize-none h-40"
          name="Contenu"
          id="Contenu"
          placeholder="Votre message..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="px-8 py-3 text-sm font-semibold rounded-xl bg-accent-500 text-white hover:bg-accent-600 transition-all duration-200 shadow-lg shadow-accent-500/20 hover:shadow-accent-500/30"
      >
        Envoyer
      </button>
    </form>
  </section>
</Layout>
