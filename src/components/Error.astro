---
interface Props {
  errnum: number;
}

const { errnum } = Astro.props;
---

<div class="w-max mx-auto text-center text-2xl font-semibold">
  <p>Oups, il semblerait qu'une erreur se soit produite.</p>
  <p class="inline">
    Code erreur : <p class="italic inline font-bold">{errnum}</p>
  </p>
</div>
<slot />
