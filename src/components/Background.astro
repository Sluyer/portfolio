---
---
<canvas id="bg-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-[-1] opacity-70"></canvas>

<script>
  function initCanvas() {
    /** @type {HTMLCanvasElement | null} */
    const canvas = (document.getElementById('bg-canvas'));
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width, height;
    let particles = [];

    function resize() {
      // Account for device pixel ratio for sharp rendering on Retina/High-DPI displays
      const dpr = window.devicePixelRatio || 1;
      width = window.innerWidth;
      height = window.innerHeight;
      
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      
      // Scale down to logical CSS pixels
      ctx.scale(dpr, dpr);
    }

    class Particle {
      constructor() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        // Random velocity
        this.vx = (Math.random() - 0.5) * 0.3;
        this.vy = (Math.random() - 0.5) * 0.3;
        // Wavy angle
        this.angle = Math.random() * Math.PI * 2;
        // Wavy speed
        this.angleSpeed = (Math.random() - 0.5) * 0.02;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        
        // Add a wavy, web-like motion
        this.angle += this.angleSpeed;
        this.x += Math.cos(this.angle) * 0.5;
        this.y += Math.sin(this.angle) * 0.5;

        // Bounce off edges smoothly without getting stuck
        if (this.x < 0) {
          this.x = 0;
          this.vx *= -1;
        } else if (this.x > width) {
          this.x = width;
          this.vx *= -1;
        }
        
        if (this.y < 0) {
          this.y = 0;
          this.vy *= -1;
        } else if (this.y > height) {
          this.y = height;
          this.vy *= -1;
        }
      }

      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, 1.5, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(99, 102, 241, 0.7)'; // Indigo color
        ctx.fill();
      }
    }

    function initParticles() {
      particles = [];
      // Adjust density based on screen size, with a random variation so each page load is slightly different
      const baseDensity = 12000;
      const randomFactor = 0.8 + (Math.random() * 0.4); 
      // Cap particles to prevent massive frame drops on 4K/large displays
      const rawNumParticles = Math.floor((window.innerWidth * window.innerHeight) / (baseDensity * randomFactor));
      const numParticles = Math.min(rawNumParticles, 150); // Set a reasonable hard cap
      
      for (let i = 0; i < numParticles; i++) {
        particles.push(new Particle());
      }
    }

    let animationFrameId;

    function animate() {
      ctx.clearRect(0, 0, width, height);
      
      for (let i = 0; i < particles.length; i++) {
        particles[i].update();
        particles[i].draw();
        
        // Draw the web
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const distSq = dx * dx + dy * dy;
          
          // 150 * 150 = 22500 (much faster than calculating Math.sqrt for every pair)
          if (distSq < 22500) {
            const dist = Math.sqrt(distSq);
            ctx.beginPath();
            // The closer they are, the more opaque the line
            ctx.strokeStyle = `rgba(99, 102, 241, ${0.35 * (1 - dist / 150)})`;
            ctx.lineWidth = 1;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }
      animationFrameId = requestAnimationFrame(animate);
    }

    window.addEventListener('resize', resize);
    resize();
    initParticles();
    animate();

    // Astro ViewTransitions cleanup so it resets properly on each page change
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener('resize', resize);
    }, { once: true });
  }

  // Re-run on every page load/transition
  document.addEventListener('astro:page-load', initCanvas);
</script>
